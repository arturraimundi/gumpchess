{
  "permissions": {
    "allow": [
      "Bash(npm test*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run test:db*)",
      "Bash(./scripts/test-db.sh*)",
      "Bash(git status*)",
      "Bash(git diff*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-tests.sh", "timeout": 180 }
        ]
      }
    ]
  }
}
